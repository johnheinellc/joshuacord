---
/**
 * CaseFileSpread — the expanded popup for a case file.
 *
 * Opens when a CaseFileCard is clicked. The overflow content is laid out as
 * loose pages spread across an open folder: page 1 tilted left, page 2 tilted
 * right, and a photo + action page stacked on the right. Wraps to a single
 * column on narrow screens.
 *
 * Accepts the same [[...]] redaction tokens as CaseFileCard.
 */

export interface SpreadPage {
  kicker?: string;   // small left-hand meta word, e.g. "Continued"
  eyebrow?: string;  // scarlet uppercase label
  headline?: string; // stencil headline (page 1 only, normally)
  fields?: { label: string; value: string }[];
  paragraphs?: string[];
  quote?: string;
  stamp?: string;
  cta?: { label: string; href: string };
}

export interface CaseFileSpreadData {
  caseNo: string;
  photo?: { src: string; alt: string; caption?: string };
  pages: SpreadPage[];   // first two render as the large sheets, third as the action page
}

interface Props {
  data: CaseFileSpreadData;
  open?: boolean;
}
const { data, open = false } = Astro.props;

function redact(text = "") {
  return text.split(/(\[\[[^\]]*\]\]|X+)/g).map((part) => {
    const isToken = part.startsWith("[[");
    const isPlaceholder = /^X+$/.test(part);
    if (!isToken && !isPlaceholder) return { bar: false, text: part, chars: 0 };
    const inner = isToken ? part.slice(2, -2) : part;
    const chars = isToken && /^\d+$/.test(inner) ? Number(inner) : inner.length;
    return { bar: true, text: "", chars };
  });
}

const pageCount = data.pages.length;
---

<div class="cfs" data-case={`case-${data.caseNo}`} data-open={open ? "true" : "false"} role="dialog" aria-modal="true" aria-label={`Case file ${data.caseNo}`}>
  <div class="cfs-inner">
    <header class="cfs-bar">
      <div class="cfs-brand">
        <span>Joshuacord</span>
        <span class="cfs-brand-sub">Case File / {data.caseNo} — {pageCount} pages</span>
      </div>
      <button type="button" class="cfs-close" data-cfs-close>Close file ✕</button>
    </header>

    <div class="cfs-desk">
      <div class="cfs-folder" aria-hidden="true"></div>
      <div class="cfs-folder-tab" aria-hidden="true">Case No. {data.caseNo}</div>

      <div class="cfs-pages">
        {data.pages.map((page, index) => (
          <article class:list={["cfs-sheet", "jc-grain", index === 0 ? "cfs-sheet--one" : "cfs-sheet--continuation"]}>
            <div class="cfs-meta"><span>{page.kicker ?? (index === 0 ? "Joshuacord" : "Continued")}</span><span>Page {index + 1} / {pageCount}</span></div>
            <div class="cfs-rule"></div>
            {page.eyebrow && <div class="cfs-eyebrow">{page.eyebrow}</div>}
            {page.headline && <h1 class="cfs-h1">{page.headline}</h1>}
            {page.fields && page.fields.length > 0 && (
              <dl class="cfs-fields">
                {page.fields.map((row) => (
                  <>
                    <dt>{row.label}</dt>
                    <dd>
                      {redact(row.value).map((part) =>
                        part.bar
                          ? <span class="cfs-bar" style={`width:${part.chars * 0.55}em`} aria-label="Redacted"></span>
                          : part.text
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            )}
            {(page.paragraphs ?? []).map((text) => (
              <p class="cfs-body">
                {redact(text).map((part) =>
                  part.bar
                    ? <span class="cfs-nb"><span class="cfs-bar" style={`width:${part.chars * 0.55}em`} aria-label="Redacted"></span></span>
                    : part.text
                )}
              </p>
            ))}
          </article>
        ))}

        <div class="cfs-side">
          {data.photo && (
            <figure class="cfs-photo">
              <img src={data.photo.src} alt={data.photo.alt} />
              {data.photo.caption && <figcaption>{data.photo.caption}</figcaption>}
            </figure>
          )}

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cfs {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    background: rgba(45, 24, 16, 0.9);
    padding: 56px 32px 96px;
    box-sizing: border-box;
    display: none;
    justify-content: center;
    font-family: "Inter", system-ui, sans-serif;
    color: #2d1810;
  }
  .cfs[data-open="true"] { display: flex; }
  .cfs * { box-sizing: border-box; }

  .cfs-inner { position: relative; width: 100%; max-width: 1560px; }

  .cfs-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
  }
  .cfs-brand {
    display: flex;
    align-items: baseline;
    gap: 22px;
    font-size: 16px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: #d8b36f;
  }
  .cfs-brand-sub { color: #c39b57; }
  .cfs-close {
    background: transparent;
    border: 1px solid rgba(216, 179, 111, 0.45);
    color: #f0ddb8;
    border-radius: 999px;
    padding: 10px 22px;
    font: 600 15px/1 "Inter", sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease-out, border-color 180ms ease-out;
  }
  .cfs-close:hover { border-color: #c0392b; color: #e74c3c; }

  .cfs-desk { position: relative; padding: 44px 0 120px; }
  .cfs-folder {
    position: absolute;
    left: 2%;
    right: 2%;
    top: 120px;
    bottom: 0;
    background: #c39b57;
    border-radius: 14px;
    transform: rotate(-1.1deg);
    box-shadow: 0 60px 100px -40px rgba(0, 0, 0, 0.7);
  }
  .cfs-folder-tab {
    position: absolute;
    left: 4%;
    top: 96px;
    width: min(340px, 40%);
    height: 58px;
    background: #d8b36f;
    border-radius: 12px 12px 0 0;
    transform: rotate(-1.1deg);
    display: flex;
    align-items: center;
    padding: 0 28px;
    font-size: 17px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: #4a3524;
  }

  .cfs-pages {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 0;
    padding: 0 24px;
  }

  .cfs-sheet {
    position: relative;
    background: #fdfbf4;
    border: 1px solid rgba(122, 92, 60, 0.18);
    border-radius: 4px;
    aspect-ratio: 7.5 / 11.5;
    height: auto;
    overflow: hidden;
    box-shadow: 0 30px 56px -26px rgba(0, 0, 0, 0.55);
    padding: 52px 48px 60px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: flex-start;
  }
  .cfs-sheet--one { flex: 1 1 380px; max-width: 520px; min-width: 0; transform: rotate(-2.2deg); z-index: 3; }
  .cfs-sheet--continuation { flex: 1 1 380px; max-width: 520px; min-width: 0; background: #fbf6e9; transform: rotate(0.6deg); margin-top: 58px; z-index: 2; }
  .cfs-sheet--three { margin-top: 34px; padding: 40px 36px 46px; gap: 20px; transform: rotate(2.6deg); }

  .cfs-side {
    flex: 0 1 320px;
    max-width: 320px;
    min-width: 0;
    align-self: flex-start;
    margin-top: 88px;
    position: relative;
    z-index: 4;
  }

  .cfs-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: #7a5c3c;
  }
  .cfs-rule { height: 1px; background: rgba(122, 92, 60, 0.28); }
  .cfs-eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: #c0392b;
  }
  .cfs-h1 {
    margin: 0;
    font-family: "Capture It", "Playfair Display", serif;
    font-weight: 600;
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: pretty;
  }

  .cfs-fields {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 22px;
    row-gap: 4px;
    margin: 0;
    font-size: 17px;
    align-items: center;
  }
  .cfs-fields dt { text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; color: #7a5c3c; }
  .cfs-fields dd { margin: 0; border-bottom: 1px dotted rgba(122, 92, 60, 0.5); padding-bottom: 2px; }

  .cfs-body { margin: 0; font-size: 14px; line-height: 1.3; color: #4a3524; text-wrap: pretty; }
  .cfs-body--sm { font-size: 13px; line-height: 1.28; }

  .cfs-nb { display: inline-block; height: 1em; line-height: 1; white-space: nowrap; vertical-align: middle; }
  .cfs-bar {
    display: inline-block;
    height: 0.85em;
    line-height: 1;
    background: #2d1810;
    border-radius: 2px;
    vertical-align: middle;
  }

  .cfs-quote {
    margin: 0;
    padding: 28px 32px;
    background: #f6edda;
    border-left: 5px solid #c0392b;
    border-radius: 3px;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.35;
    color: #2d1810;
    text-wrap: pretty;
  }

  .cfs-stamp {
    align-self: center;
    margin-top: 8px;
    transform: rotate(-6deg);
    border: 4px solid rgba(192, 57, 43, 0.7);
    color: rgba(192, 57, 43, 0.85);
    padding: 8px 18px;
    border-radius: 4px;
    font-family: "Capture It", "Playfair Display", serif;
    font-size: 26px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cfs-photo {
    position: relative;
    margin: 0;
    background: #fff;
    padding: 16px 16px 54px;
    box-shadow: 0 26px 44px -18px rgba(0, 0, 0, 0.6);
    border-radius: 2px;
    transform: rotate(-4.6deg);
  }
  .cfs-photo img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .cfs-photo figcaption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 18px;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7a5c3c;
    text-align: center;
  }

  .cfs-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    background: #c0392b;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
    padding: 12px 26px;
    border-radius: 999px;
    transition: background 180ms ease-out;
  }
  .cfs-btn:hover { background: #922b21; }

  @media (max-width: 900px) {
    .cfs { padding: 32px 16px 64px; }
    .cfs-sheet--one,
    .cfs-sheet--continuation,
    .cfs-sheet--three,
    .cfs-photo { transform: none; margin-top: 0; }
    .cfs-sheet { aspect-ratio: 7.5 / 11.5; padding: 36px 28px 40px; }
    .cfs-side { margin-top: 24px; max-width: none; flex: 1 1 100%; }
    .cfs-pages { gap: 24px; padding: 0; }
    .cfs-folder-tab { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cfs-close, .cfs-btn { transition: none; }
  }
</style>

<script>
  // Open on card click, close on button / backdrop / Escape.
  function openById(id: string) {
    const spread = document.querySelector<HTMLElement>(`.cfs[data-case="${id}"]`);
    if (!spread) return;
    spread.setAttribute("data-open", "true");
    document.body.style.overflow = "hidden";
  }

  document.querySelectorAll<HTMLElement>("[data-cfs-open]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.dataset.cfsOpen;
      if (id) openById(id);
    });
  });

  // Deep-linked from elsewhere (e.g. the homepage carousel): #case-19 opens that case's popup.
  function openFromHash() {
    const id = window.location.hash.slice(1);
    if (id) openById(id);
  }
  openFromHash();
  window.addEventListener("hashchange", openFromHash);

  function closeAll() {
    document.querySelectorAll<HTMLElement>(".cfs").forEach((el) => el.setAttribute("data-open", "false"));
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-cfs-close]").forEach((btn) =>
    btn.addEventListener("click", closeAll)
  );
  document.querySelectorAll<HTMLElement>(".cfs").forEach((el) =>
    el.addEventListener("click", (event) => { if (event.target === el) closeAll(); })
  );
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeAll(); });
</script>
