---
import Layout from '../layouts/Layout.astro';

const carouselSlides = [
  {
    bg: 'var(--color-dark)',
    eyebrow: 'Ribbon Campaign',
    eyebrowColor: 'var(--color-clay)',
    color: 'var(--color-sand)',
    title: 'Persecuted But Not Forgotten',
    copy: 'Display the scarlet ribbon on your car or door to remind the world of the persecuted church.',
    cta: 'Get a Ribbon',
    img: 'https://joshuacord.org/wp-content/uploads/2014/08/JC-Logo-header3.png',
    imgRound: false,
  },
  {
    bg: 'var(--color-brand)',
    eyebrow: 'Documentary',
    eyebrowColor: 'rgba(255,255,255,.75)',
    color: '#fff',
    title: 'Christians in the Mirror',
    copy: 'Stories of courage and faith in the face of persecution — from Aleppo and northern Iraq to India, South Sudan, and Egypt.',
    cta: 'Watch the Film',
    img: 'https://joshuacord.org/wp-content/uploads/2014/08/JC-Logo-header3.png',
    imgRound: true,
  },
  {
    bg: 'var(--color-dark)',
    eyebrow: 'Annual Event',
    eyebrowColor: 'var(--color-brand)',
    color: 'var(--color-sand)',
    title: 'Joshua 1:9 Freedom Run',
    copy: 'Our annual 5K in Tampa raises funds and awareness for persecuted Christians. “Be strong and courageous.”',
    cta: 'Register to Run',
    img: null,
    imgRound: false,
  },
];
---

<Layout title="Home" description="Joshuacord stands with persecuted Christians around the world through prayer, practical aid, and advocacy.">

  <main class="flex flex-col lg:flex-row lg:items-start lg:gap-10">
    <aside class="w-full lg:w-[25%] lg:sticky lg:top-[108px] min-h-[28rem] lg:min-h-[calc(100vh-108px)]">
      <section id="vertical-carousel" aria-roledescription="carousel" class="relative h-full overflow-hidden rounded-[32px] shadow-[0_30px_80px_-40px_rgba(45,24,16,0.6)]">
        <div id="vertical-carousel-track" class="h-full transition-transform duration-500 ease-out">
          {carouselSlides.map((slide) => (
            <div class="h-full min-h-[calc(100vh-108px)] p-8" style={`background: ${slide.bg};`}>
              <div class="h-full flex flex-col justify-between gap-6 text-left">
                <div>
                  <div class="text-[13px] font-semibold uppercase tracking-[0.12em] mb-4" style={`color: ${slide.eyebrowColor};`}>
                    {slide.eyebrow}
                  </div>
                  <h2 class="font-display" style={`font-size: clamp(20px, 1.8vw, 32px); color: ${slide.color}; line-height: 1.1; margin: 0; font-weight: 400;`}>{slide.title}</h2>
                  <p class="mt-6" style={`color: ${slide.color}; opacity: 0.85; line-height: 1.7; max-width: 520px;`}>{slide.copy}</p>
                </div>
                {slide.img ? (
                  <img src={slide.img} alt="" class={slide.imgRound ? 'max-h-44 max-w-full rounded-full' : 'max-h-44 max-w-full rounded-[20px]'} />
                ) : null}
                <button class="mt-6 inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold tracking-wide text-sand transition hover:bg-white/20" style={`color: ${slide.color}; border-color: ${slide.color};`}>
                  {slide.cta}
                </button>
              </div>
            </div>
          ))}
        </div>

        <div class="absolute right-4 top-1/2 -translate-y-1/2 flex flex-col items-center gap-3">
          <button id="carousel-prev" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-sand/25 bg-white/10 text-sand transition hover:bg-white/20">
            ↑
          </button>
          <div id="carousel-dots" class="flex flex-col gap-2">
            {carouselSlides.map((_, index) => (
              <button type="button" data-index={index} class="h-3 w-3 rounded-full bg-sand/50 transition" aria-label={`Go to slide ${index + 1}`} />
            ))}
          </div>
          <button id="carousel-next" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-sand/25 bg-white/10 text-sand transition hover:bg-white/20">
            ↓
          </button>
        </div>
      </section>
    </aside>

    <div class="w-full lg:w-[75%] lg:border-l lg:border-sand/10 lg:pl-10 bg-dark">
      <section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
          <img
            src="https://joshuacord.org/wp-content/uploads/2014/08/HiRes-scaled.jpg"
            alt=""
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-br from-dark/90 via-dark/75 to-brand-dark/60"></div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <p class="text-clay text-sm font-medium tracking-[0.2em] uppercase mb-6">Joshua 1:9</p>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl text-white mb-6 leading-tight">
            Persecuted But<br />
            <span class="text-brand-light italic">Not Forgotten</span>
          </h1>
          <p class="text-white/75 text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed font-light">
            More than 150,000 Christians face persecution for their faith each year.
            We stand with them — through prayer, practical aid, and a voice that refuses to be silent.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/mission-fields"
              class="bg-brand hover:bg-brand-dark text-white px-8 py-4 text-sm font-medium tracking-wide transition-colors w-full sm:w-auto text-center"
            >
              See the Mission
            </a>
            <a
              href="/donate"
              class="border border-white/60 hover:border-white text-white hover:bg-white/10 px-8 py-4 text-sm font-medium tracking-wide transition-colors w-full sm:w-auto text-center"
            >
              Give Today
            </a>
          </div>
        </div>

        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/40 animate-bounce">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </section>

      <!-- IMPACT NUMBERS -->
  <section class="bg-brand text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
        <div>
          <p class="font-display text-5xl font-bold mb-2">150,000<span class="text-brand-light">+</span></p>
          <p class="text-white/70 text-sm tracking-wide uppercase">Christians persecuted annually</p>
        </div>
        <div>
          <p class="font-display text-5xl font-bold mb-2">8</p>
          <p class="text-white/70 text-sm tracking-wide uppercase">Active mission regions</p>
        </div>
        <div>
          <p class="font-display text-5xl font-bold mb-2">2</p>
          <p class="text-white/70 text-sm tracking-wide uppercase">Documentary films produced</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="py-24 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Image -->
        <div class="relative">
          <img
            src="https://joshuacord.org/wp-content/uploads/2017/10/sadasdf-27-scaled.jpg"
            alt="Joshuacord mission work"
            class="w-full h-96 object-cover"
          />
          <!-- Red accent border -->
          <div class="absolute -bottom-4 -right-4 w-32 h-32 border-4 border-brand -z-10"></div>
        </div>

        <!-- Text -->
        <div class="space-y-6">
          <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase">Our Story</p>
          <h2 class="font-display text-4xl text-sand">The Cord That Binds Us</h2>
          <div class="w-12 h-0.5 bg-brand"></div>
          <p class="text-sand/80 leading-relaxed">
            The name Joshuacord comes from the biblical account of Joshua, Rahab, and the scarlet cord.
            Rahab displayed a scarlet cord in her window — an act of courage, faith, and kindness —
            and it saved her life. That cord connects us across centuries to a truth we hold today:
            no persecuted believer should be left without hope.
          </p>
          <p class="text-sand/80 leading-relaxed">
            As a 501(c)(3) nonprofit, Joshuacord brings prayer, practical aid, and global awareness
            to the more than 150,000 Christians who suffer for their faith every year.
          </p>
          <a
            href="/about"
            class="inline-block border-b-2 border-brand text-brand font-medium text-sm hover:text-brand-dark hover:border-brand-dark transition-colors pb-0.5"
          >
            Learn More About Us →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- GLOBAL IMPACT GLOBE -->
  <section class="py-24 bg-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-10">
      <div class="space-y-6">
        <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase">Countries We Help</p>
        <h2 class="font-display text-5xl md:text-6xl text-sand tracking-[-0.03em]">Where the Cord Reaches</h2>
        <p class="text-sand/80 text-lg leading-relaxed max-w-3xl mx-auto">
          Spin the globe and tap a marker to see where Joshuacord stands with the persecuted church.
        </p>
      </div>

      <div class="globe-shell mx-auto" id="globe-stage" role="img" aria-label="Interactive globe showing Joshuacord mission locations">
        <canvas id="globe-canvas" class="globe-canvas" aria-label="Interactive globe"></canvas>
        <div class="globe-ring"></div>
        <div id="globe-popup" class="globe-popup hidden" role="dialog" aria-label="Mission field details">
          <button id="globe-popup-close" class="globe-popup-close" aria-label="Close details">×</button>
          <a id="globe-popup-link" class="globe-popup-link" href="/mission-fields#afghanistan"></a>
          <p id="globe-popup-desc" class="globe-popup-desc"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION FIELDS PREVIEW -->
  <section class="py-24 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase mb-3">Where We Work</p>
        <h2 class="font-display text-4xl text-sand mb-4">Mission Fields</h2>
        <div class="w-12 h-0.5 bg-brand mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { name: 'Afghanistan', desc: 'Under Taliban rule, faith is practiced in total secrecy.' },
          { name: 'Egypt', desc: 'Coptic Christians face discrimination and attacks on churches.' },
          { name: 'Iraq', desc: 'Ancient Christian communities decimated by war and ISIS.' },
          { name: 'Nigeria', desc: 'Thousands killed by Boko Haram and militant violence.' },
          { name: 'Somalia', desc: 'Among the world\'s most dangerous nations for Christians.' },
          { name: 'Sudan', desc: 'Decades of persecution and forced displacement.' },
          { name: 'Syria', desc: 'Civil war scattered a 2,000-year Christian presence.' },
          { name: 'India', desc: 'Anti-conversion laws and rising religious nationalism.' },
        ].map((field) => (
          <a
            href={`/mission-fields#${field.name.toLowerCase()}`}
            class="group bg-dark border border-clay/30 p-5 hover:border-brand/40 hover:bg-dark/80 transition-all"
          >
            <h3 class="font-display text-lg text-sand group-hover:text-brand transition-colors mb-2">
              {field.name}
            </h3>
            <p class="text-xs text-sand/70 leading-relaxed">{field.desc}</p>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="/mission-fields"
          class="inline-block bg-dark hover:bg-brand text-white text-sm font-medium tracking-wide px-8 py-3.5 transition-colors"
        >
          Explore All Mission Fields
        </a>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/d3-array@3"></script>
  <script src="https://cdn.jsdelivr.net/npm/d3-geo@3"></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3"></script>
  <script>
    const PLACES = [
      { id: 'afghanistan', name: 'Afghanistan', region: 'Afghanistan', coords: [65.6, 33.9], body: 'Believers meet in secret under Taliban rule.' },
      { id: 'egypt', name: 'Egypt', region: 'Egypt', coords: [30.8, 26.8], body: 'Coptic Christians face discrimination and violence.' },
      { id: 'india', name: 'India', region: 'India', coords: [78.9, 21.0], body: 'Rising persecution under anti-conversion laws.' },
      { id: 'iraq', name: 'Iraq', region: 'Iraq', coords: [44.4, 33.3], body: 'Rebuilding communities in the Nineveh Plains.' },
      { id: 'nigeria', name: 'Nigeria', region: 'Nigeria', coords: [8.7, 9.1], body: 'Villages attacked and families displaced in the north.' },
      { id: 'somalia', name: 'Somalia', region: 'Somalia', coords: [46.8, 2.0], body: 'One of the most dangerous places to follow Christ.' },
      { id: 'sudan', name: 'Sudan', region: 'Sudan', coords: [32.5, 12.0], body: 'Christians face forced Islamization and attacks from militant groups.' },
      { id: 'southsudan', name: 'South Sudan', region: 'South Sudan', coords: [31.6, 7.8], body: 'Aid for refugees fleeing conflict and famine.' },
      { id: 'syria', name: 'Syria', region: 'Syria', coords: [38.0, 34.8], body: 'Standing with churches in Aleppo and beyond.' },
    ];

    const canvas = document.getElementById('globe-canvas');
    const stage = document.getElementById('globe-stage');
    const popup = document.getElementById('globe-popup');
    const popupClose = document.getElementById('globe-popup-close');
    const popupLink = document.getElementById('globe-popup-link');
    const popupDesc = document.getElementById('globe-popup-desc');
    const ctx = canvas.getContext('2d');

    let land = null;
    let borders = null;
    let ready = false;
    let running = false;
    let dragging = false;
    let busy = false;
    let selectedId = null;
    let lastT = 0;
    let autoSpin = true;
    let pauseTimer = null;
    let rotation = [-30, -12, 0];
    let W = 0;
    let H = 0;
    let dpr = 1;
    let radius = 0;

    const projection = d3.geoOrthographic();
    const path = d3.geoPath(projection, ctx);
    const sphere = { type: 'Sphere' };
    const graticule = d3.geoGraticule10();

    function resize() {
      const rect = stage.getBoundingClientRect();
      W = Math.max(240, Math.round(rect.width));
      H = Math.max(240, Math.round(rect.width));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      radius = Math.min(W, H) / 2 - 14;
      projection.scale(radius).translate([W / 2, H / 2]);
    }

    function center() {
      return [-rotation[0], -rotation[1]];
    }

    function visible(coords) {
      return d3.geoDistance(coords, center()) < 1.5707;
    }

    function draw(t) {
      if (!ready) return;
      projection.rotate(rotation);
      ctx.clearRect(0, 0, W, H);

      ctx.beginPath(); path(sphere); ctx.fillStyle = '#2D1810'; ctx.fill();
      ctx.beginPath(); path(graticule); ctx.lineWidth = 0.5; ctx.strokeStyle = 'rgba(250,240,220,0.12)'; ctx.stroke();
      ctx.beginPath(); path(land); ctx.fillStyle = '#FAF0DC'; ctx.fill();
      ctx.beginPath(); path(borders); ctx.lineWidth = 0.6; ctx.strokeStyle = 'rgba(45,24,16,0.35)'; ctx.stroke();
      ctx.beginPath(); path(sphere); ctx.lineWidth = 1.2; ctx.strokeStyle = 'rgba(250,240,220,0.35)'; ctx.stroke();

      const pulse = Math.sin(t / 620) * 0.5 + 0.5;
      PLACES.forEach((m) => {
        if (!visible(m.coords)) return;
        const p = projection(m.coords);
        if (!p) return;
        const sel = m.id === selectedId;
        const glowR = 6 + 4 * pulse + (sel ? 4 : 0);
        const g = ctx.createRadialGradient(p[0], p[1], 0, p[0], p[1], glowR);
        g.addColorStop(0, 'rgba(192,57,43,0.24)');
        g.addColorStop(1, 'rgba(192,57,43,0)');
        ctx.beginPath(); ctx.arc(p[0], p[1], glowR, 0, Math.PI * 2); ctx.fillStyle = g; ctx.fill();
        ctx.beginPath(); ctx.arc(p[0], p[1], sel ? 5.5 : 4.5, 0, Math.PI * 2); ctx.fillStyle = '#C0392B'; ctx.fill();
        ctx.lineWidth = 1.6; ctx.strokeStyle = '#FAF0DC'; ctx.stroke();
      });
    }

    function frame(now) {
      if (!running) return;
      if (!lastT) lastT = now;
      const dt = (now - lastT) / 1000;
      lastT = now;
      if (autoSpin && !dragging && !busy) {
        rotation[0] = (rotation[0] + dt * 6) % 360;
      }
      draw(now);
      window.requestAnimationFrame(frame);
    }

    function pauseAutoSpin() {
      autoSpin = false;
      window.clearTimeout(pauseTimer);
      pauseTimer = window.setTimeout(() => {
        autoSpin = true;
      }, 4000);
    }

    function start() {
      if (running) return;
      running = true;
      lastT = 0;
      window.requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
    }

    function sensitivity() {
      return 75 / projection.scale();
    }

    let down = null;
    function onDown(event) {
      dragging = true;
      down = { x: event.clientX, y: event.clientY, r0: rotation[0], r1: rotation[1], moved: 0 };
      canvas.setPointerCapture?.(event.pointerId);
    }

    function onMove(event) {
      if (!dragging || !down) return;
      const dx = event.clientX - down.x;
      const dy = event.clientY - down.y;
      down.moved = Math.max(down.moved, Math.abs(dx) + Math.abs(dy));
      rotation[0] = down.r0 + dx * sensitivity();
      rotation[1] = Math.max(-90, Math.min(90, down.r1 - dy * sensitivity()));
      event.preventDefault();
    }

    function onUp(event) {
      if (!dragging) return;
      dragging = false;
      canvas.releasePointerCapture?.(event.pointerId);
      if (down && down.moved < 6) {
        handleTap(event);
      } else if (down && down.moved >= 6) {
        pauseAutoSpin();
      }
      down = null;
    }

    function handleTap(event) {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      let best = null;
      let bestD = 26 * 26;
      PLACES.forEach((m) => {
        if (!visible(m.coords)) return;
        const p = projection(m.coords);
        if (!p) return;
        const d = (p[0] - x) ** 2 + (p[1] - y) ** 2;
        if (d < bestD) { bestD = d; best = m; }
      });
      if (best) focusMarker(best);
    }

    function spinTo(m, cb) {
      const from = [rotation[0], rotation[1]];
      const to = [-m.coords[0], -m.coords[1]];
      const d0 = ((to[0] - from[0]) % 360 + 540) % 360 - 180;
      const dur = 620;
      let startT = null;
      const tween = { cancelled: false };
      function step(now) {
        if (tween.cancelled) return;
        if (startT === null) startT = now;
        const u = Math.min(1, (now - startT) / dur);
        const e = u < 0.5 ? 2*u*u : 1 - Math.pow(-2*u + 2, 2) / 2;
        rotation[0] = from[0] + d0 * e;
        rotation[1] = from[1] + (to[1] - from[1]) * e;
        if (u < 1) window.requestAnimationFrame(step);
        else if (cb) cb();
      }
      window.requestAnimationFrame(step);
      return tween;
    }

    function focusMarker(m) {
      if (busy) return;
      busy = true;
      selectedId = m.id;
      pauseAutoSpin();
      spinTo(m, () => { busy = false; openPopup(m); });
    }

    function openPopup(m) {
      selectedId = m.id;
      popupLink.textContent = m.region;
      popupLink.href = `/mission-fields#${m.id}`;
      popupDesc.textContent = m.body;
      popup.classList.remove('hidden');
      popup.focus();
    }

    function closePopup() {
      popup.classList.add('hidden');
      selectedId = null;
    }

    function setDefaultState() {
      selectedId = null;
      popup.classList.add('hidden');
    }

    async function loadWorld() {
      const response = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
      const world = await response.json();
      land = topojson.feature(world, world.objects.land);
      borders = topojson.mesh(world, world.objects.countries);
      ready = true;
      resize();
    }

    function init() {
      resize();
      canvas.addEventListener('pointerdown', onDown);
      canvas.addEventListener('pointermove', onMove);
      canvas.addEventListener('pointerup', onUp);
      canvas.addEventListener('pointercancel', onUp);
      window.addEventListener('resize', resize);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((entry) => { entry.isIntersecting ? start() : stop(); });
        }, { threshold: 0.02 }).observe(stage);
      } else { start(); }
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
      popupClose?.addEventListener('click', closePopup);
      popup?.addEventListener('click', (event) => {
        if (event.target === popup) closePopup();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePopup();
      });
      loadWorld();
      setDefaultState();
      start();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>

  <script type="module">
    const track = document.getElementById('vertical-carousel-track');
    const prevButton = document.getElementById('carousel-prev');
    const nextButton = document.getElementById('carousel-next');
    const dots = document.querySelectorAll('#carousel-dots [data-index]');
    let currentSlide = 0;
    const slideCount = dots.length;
    const autoplayInterval = 6000;
    let autoplayTimer;

    function updateCarousel(index) {
      if (!track) return;
      currentSlide = ((index % slideCount) + slideCount) % slideCount;
      track.style.transform = `translateY(-${currentSlide * 100}%)`;
      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle('bg-sand/100', dotIndex === currentSlide);
        dot.classList.toggle('bg-sand/50', dotIndex !== currentSlide);
      });
    }

    function resetAutoplay() {
      clearInterval(autoplayTimer);
      autoplayTimer = setInterval(() => updateCarousel(currentSlide + 1), autoplayInterval);
    }

    prevButton?.addEventListener('click', () => {
      updateCarousel(currentSlide - 1);
      resetAutoplay();
    });

    nextButton?.addEventListener('click', () => {
      updateCarousel(currentSlide + 1);
      resetAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.index);
        updateCarousel(index);
        resetAutoplay();
      });
    });

    updateCarousel(0);
    resetAutoplay();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearInterval(autoplayTimer);
      } else {
        resetAutoplay();
      }
    });
