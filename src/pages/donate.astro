---
import Layout from '../layouts/Layout.astro';
import { ONE_TIME_GIFT_URL, MONTHLY_GIFTS } from '../data/donations';
---

<Layout
  title="Donate"
  description="Give to Joshuacord and support persecuted Christians around the world with prayer, practical aid, and advocacy."
>

  <!-- PAGE HERO -->
  <section class="relative bg-dark py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/home-hero.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-clay text-sm font-medium tracking-[0.2em] uppercase mb-4">Make a Difference</p>
      <h1 class="font-display text-5xl sm:text-6xl text-white mb-5">Give Today</h1>
      <div class="w-12 h-0.5 bg-brand mx-auto mb-6"></div>
      <p class="text-white/65 text-lg leading-relaxed max-w-2xl mx-auto">
        Every dollar you give helps Joshuacord bring prayer, practical aid, and a voice
        of hope to Christians suffering for their faith around the world.
      </p>
    </div>
  </section>

  <!-- MAIN DONATION SECTION -->
  <section class="py-24 bg-sand">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 items-start">

        <!-- LEFT: Ways to give. Each button is a plain link to a Stripe Payment Link
             (see src/data/donations.ts); the gift is completed on Stripe's checkout page. -->
        <div class="lg:col-span-3 space-y-12">
          <p class="text-dark/70 leading-relaxed">
            Give once, or join our monthly Freedom Partners. Either way, you'll complete your gift
            on Stripe's secure checkout page — and you can designate your gift to a specific
            mission field at checkout.
          </p>

          <!-- One-time gift -->
          <div id="one-time" class="scroll-mt-28">
            <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase mb-3">Give Once</p>
            <h2 class="font-display text-3xl text-dark mb-4">One-Time Gift</h2>
            <div class="w-10 h-0.5 bg-brand mb-5"></div>
            <p class="text-dark/70 text-sm leading-relaxed mb-6">
              Give any amount you choose. You'll enter the amount on the next page.
            </p>
            <a
              href={ONE_TIME_GIFT_URL}
              class="block w-full bg-brand hover:bg-brand-dark text-white py-4 text-sm font-medium tracking-wide text-center transition-colors"
            >
              Give a One-Time Gift
            </a>
          </div>

          <!-- Monthly: Freedom Partner -->
          <div id="monthly" class="scroll-mt-28">
            <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase mb-3">Give Monthly</p>
            <h2 class="font-display text-3xl text-dark mb-4">Become a Freedom Partner</h2>
            <div class="w-10 h-0.5 bg-brand mb-5"></div>
            <div class="bg-brand/8 border border-brand/20 px-5 py-4 mb-6">
              <p class="text-brand text-sm font-medium">Freedom Partner</p>
              <p class="text-dark/65 text-xs mt-1 leading-relaxed">
                A monthly commitment provides sustained, reliable support that persecuted believers
                can count on. Your recurring gift makes long-term ministry possible.
              </p>
            </div>

            <p class="text-dark/60 text-xs uppercase tracking-wide mb-3">Choose a Monthly Amount</p>
            <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 list-none m-0 p-0">
              {MONTHLY_GIFTS.map(({ amount, url }) => (
                <li>
                  <a
                    href={url}
                    aria-label={`Give $${amount} per month as a Freedom Partner`}
                    class="block border border-clay/50 hover:border-brand hover:bg-brand text-dark hover:text-white py-4 text-center transition-colors"
                  >
                    <span class="block text-2xl font-semibold">${amount}</span>
                    <span class="block text-xs uppercase tracking-wide opacity-70 mt-1">per month</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="text-dark/60 text-xs leading-relaxed mt-4">
              To change or cancel a monthly gift at any time, email
              <a href="mailto:donations@joshuacord.org" class="text-brand hover:underline">donations@joshuacord.org</a>.
            </p>
          </div>

          <!-- Checkout note -->
          <div class="bg-sand-dark border border-clay/30 p-5">
            <p class="text-dark/70 text-xs leading-relaxed">
              <strong class="text-dark">Secure checkout by Stripe.</strong> Your payment details are
              entered on Stripe's secure page, never on this site. When your gift is complete,
              you'll be brought back to joshuacord.org.
            </p>
          </div>
        </div>

        <!-- RIGHT: Why give -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <p class="text-brand text-sm font-medium tracking-[0.2em] uppercase mb-3">Your Impact</p>
            <h2 class="font-display text-3xl text-dark mb-4">Why Your Gift Matters</h2>
            <div class="w-10 h-0.5 bg-brand mb-5"></div>
            <p class="text-dark/70 text-sm leading-relaxed">
              More than 388 million Christians face high levels of persecution for their faith. Many lose their jobs,
              their homes, and their families. Your gift provides:
            </p>
          </div>

          <ul class="space-y-4">
            {[
              { label: 'Prayer & Spiritual Support', desc: 'Connecting persecuted believers with a global community praying for them by name.' },
              { label: 'Practical Aid', desc: 'Food, shelter, and essential resources for families displaced by persecution.' },
              { label: 'Advocacy & Awareness', desc: 'Documentary films and public campaigns that refuse to let the world look away.' },
              { label: 'Regional Ministry', desc: 'Support designated to specific mission fields — your gift goes where you direct it.' },
            ].map((item) => (
              <li class="flex gap-4">
                <div class="shrink-0 w-5 h-5 mt-0.5 bg-brand/15 flex items-center justify-center">
                  <div class="w-1.5 h-1.5 bg-brand rounded-full"></div>
                </div>
                <div>
                  <p class="text-dark font-medium text-sm">{item.label}</p>
                  <p class="text-dark/60 text-xs mt-0.5 leading-relaxed">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>

          <!-- Tax info -->
          <div class="bg-sand-dark border border-clay/30 p-5">
            <p class="text-dark/70 text-xs leading-relaxed">
              <strong class="text-dark">Joshuacord Inc.</strong> is a registered 501(c)(3) nonprofit
              organization. All donations are tax-deductible to the extent permitted by law.
              You will receive a receipt for your records.
            </p>
            <p class="text-dark/70 text-xs leading-relaxed mt-3">
              Questions about a gift or receipt? Email
              <a href="mailto:donations@joshuacord.org" class="text-brand hover:underline">donations@joshuacord.org</a>.
            </p>
          </div>

          <!-- Scripture -->
          <blockquote class="border-l-3 border-clay pl-5">
            <p class="font-display text-base text-dark/80 italic leading-relaxed">
              "Your gift changes lives. Every dollar you give helps Joshuacord bring prayer,
              practical aid, and a voice of hope to Christians suffering for their faith
              around the world."
            </p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACT QUOTE -->
  <section class="py-20 bg-brand">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <blockquote>
        <p class="font-display text-2xl sm:text-3xl text-white italic leading-relaxed mb-5">
          "We don't work together — we live together."
        </p>
        <cite class="text-white/65 text-sm not-italic">
          — Um Rama, Jordan, caring for Iraqi Christian refugees
        </cite>
      </blockquote>
    </div>
  </section>

</Layout>
